# Local server only. Paid provider keys are not used.
HOST=127.0.0.1
PORT=8787
# Generate with: openssl rand -hex 32
APP_ACCESS_TOKEN=

# Optional self-hosted models only. There is no paid/cloud provider option.
# Set AI_PROVIDER=ollama-local after preparing the project-local Ollama runtime.
AI_PROVIDER=disabled
OLLAMA_BASE_URL=http://127.0.0.1:11435
TRANSLATION_MODEL=translategemma:12b
EXTRACTION_MODEL=gemma4:12b-it-qat
# Enable only after preparing the pinned local voice runtime (docs/API_SETUP.md).
SPEECH_PROVIDER=disabled
