{
  "name": "speechbridge-api",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file=.env server.mjs",
    "setup:local": "node setup-local.mjs",
    "start:local": "AUTH_MODE=development node --env-file=../.runtime/server.env server.mjs",
    "start:ai": "sh start-ai.sh",
    "test": "node --test *.test.mjs",
    "setup:accounts": "node setup-accounts.mjs",
    "start:accounts": "node --env-file=../.runtime/accounts-server.env --env-file=../.runtime/postgres/server.env server.mjs",
    "db:install": "sh db/install-local.sh",
    "db:init": "node db/local.mjs init",
    "db:start": "node db/local.mjs start",
    "db:status": "node db/local.mjs status",
    "db:stop": "node db/local.mjs stop",
    "db:migrate": "node db/local.mjs migrate",
    "db:backup": "node db/local.mjs backup",
    "db:import-accounts": "node --env-file=../.runtime/postgres/server.env db/import-accounts.mjs",
    "test:coverage": "node --test --experimental-test-coverage *.test.mjs",
    "db:verify-backup": "node db/backup.mjs verify",
    "db:restore": "node db/backup.mjs restore"
  },
  "engines": {
    "node": ">=22.16.0 <26"
  },
  "dependencies": {
    "pg": "8.23.1"
  }
}
